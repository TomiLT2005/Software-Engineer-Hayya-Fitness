{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://software-engineer-hayya-fitness.onrender.com/api/:path*"
    },
    {
      "source": "/presentacion",
      "destination": "/presentacion.html"
    },
    {
      "source": "/presentacion-v2",
      "destination": "/presentacion-v2.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
